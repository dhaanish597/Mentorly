# syntax=docker/dockerfile:1
FROM docker:28.5.2-cli AS docker-cli
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/backend:/workspace \
    PATH=/opt/vcc/gvisor:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    VCC_IPC_PARENT_DIR=/var/lib/vcc/ipc

# Docker CLI talks to the dedicated host daemon; runsc is the SAME verified host
# installation mounted read-only at /opt/vcc/gvisor, including gvisor-bin sidecars.
# Copy only the pinned modern client, not Debian's older daemon/runc package.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY exec_worker/requirements.worker.txt /workspace/exec_worker/requirements.worker.txt
RUN pip install --no-cache-dir -r /workspace/exec_worker/requirements.worker.txt

COPY backend/app/models /workspace/backend/app/models
COPY backend/app/exercises /workspace/backend/app/exercises
COPY backend/app/verification /workspace/backend/app/verification
COPY exec_worker/__init__.py /workspace/exec_worker/__init__.py
COPY exec_worker/worker_app /workspace/exec_worker/worker_app
COPY exec_worker/runner /workspace/exec_worker/runner

# Root is intentional: Docker socket access is already host-root-equivalent. Do
# not mount the socket, runtime, evidence, or shared parent into learner sandboxes.
EXPOSE 8001
CMD ["uvicorn", "exec_worker.worker_app.main:app", "--host", "0.0.0.0", "--port", "8001"]
