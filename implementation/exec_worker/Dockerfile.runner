# syntax=docker/dockerfile:1
# Disposable no-network gVisor runner image for Voice Coding Coach (§5.2, §9.1, R1 repaired).
# Copies ONLY `exec_worker/__init__.py` and `exec_worker/runner` into `/app/exec_worker/`
# with zero `worker_app` or `backend` modules, zero reference oracles, and zero secrets.

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

RUN rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/bin/wget /usr/bin/curl /usr/bin/nc /bin/nc 2>/dev/null || true

WORKDIR /app

COPY exec_worker/__init__.py /app/exec_worker/__init__.py
COPY exec_worker/runner /app/exec_worker/runner

RUN chown -R root:root /app \
    && chmod -R a+rX,u-w,g-w,o-w /app \
    && mkdir -p /ipc_in /tmp \
    && chown 65534:65534 /tmp

USER 65534:65534

ENTRYPOINT ["python3", "-I", "-B", "-c", "import sys; sys.path.insert(0, '/app'); from exec_worker.runner.run_invocation import main; raise SystemExit(main())"]
