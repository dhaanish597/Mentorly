{
  "name": "vcc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "contracts": "openapi-typescript ../backend/openapi.json -o src/types/openapi.ts",
    "contracts:check": "openapi-typescript ../backend/openapi.json -o src/types/openapi.ts --check"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@xyflow/react": "^12.12.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "openapi-typescript": "7.13.0",
    "eslint": "9.39.5",
    "@typescript-eslint/parser": "8.72.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2"
  }
}
