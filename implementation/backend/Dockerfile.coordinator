# syntax=docker/dockerfile:1
# Coordinator Service Dockerfile (`backend/Dockerfile.coordinator` — Phase 9 / T-10)

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend:/app

WORKDIR /app

COPY backend/requirements.txt /app/backend/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /app/backend/requirements.txt

COPY config /app/config
# Exclude tests, databases, local environments and other backend build artifacts.
COPY backend/app /app/backend/app

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin vcccoord \
    && mkdir -p /data/tts_cache \
    && chown -R vcccoord:vcccoord /app /data

USER 10001:10001
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
