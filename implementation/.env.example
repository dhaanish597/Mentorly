# Voice Coding Coach — Secret-Free Environment Template (Phase 0 + Phase 1)
# Never commit real API keys, tokens, or private credentials.

# Branding & Environment
VCC_ENV=development
# Branding defaults to the source-resolved config/branding.json; override only explicitly.
VCC_DATABASE_PATH=./data/vcc.db
VCC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VCC_BACKEND_PORT=8020
VCC_FRONTEND_PORT=5173
# Optional PostgreSQL URL (server-only); SQLite remains the default when empty.
VCC_DATABASE_URL=
VCC_DATABASE_SCHEMA=viva_app
VCC_CLOUD_RUNTIME=false
VCC_LOG_LEVEL=INFO

# Gnani Vachana Speech API (server-side only; P2+ live integration)
VCC_GNANI_API_KEY=
VCC_GNANI_BASE_URL=https://api.vachana.ai
VCC_GNANI_STT_MODEL=prisma-v3.0
VCC_GNANI_TTS_MODEL=timbre-v3.0
VCC_GNANI_TTS_VOICE=Avinash
VCC_GNANI_STT_TRANSPORT=rest
VCC_GNANI_MAX_CONCURRENCY=1
# Increase only after actual account entitlement has been verified. Effective cap=min(requested,verified).
VCC_GNANI_VERIFIED_CONCURRENCY=1

# Credit & Abuse Guardrails (tunable operational caps, not verified tariff conversions)
VCC_MAX_STT_SECONDS_PER_SESSION=180
VCC_MAX_TTS_CHARS_PER_SESSION=4000
VCC_GLOBAL_DAILY_CALL_LIMIT=800
VCC_TTS_CACHE_DIR=./data/tts_cache

# Selectable Model-Assisted Coaching Adapter (P6+ integration)
VCC_LLM_PROVIDER=groq
VCC_GROQ_API_KEY=
VCC_LLM_MODEL=
VCC_LLM_TIMEOUT_MS=1200
VCC_LLM_FEEDBACK_TIMEOUT_MS=5000
VCC_MODEL_DAILY_CALL_LIMIT=40
VCC_MODEL_SESSION_CALL_LIMIT=12
VCC_MODEL_MAX_CONCURRENCY=1
# Model selection and key are required; external interpretation also requires user opt-in.

# Isolated Execution Worker & gVisor Runner (P1 / T-02; keep public custom code false until live gVisor acceptance passes)
VCC_EXEC_WORKER_URL=http://exec-worker:8001
# Required for Compose. Generate a random secret out of band; never use an example token.
VCC_INTERNAL_WORKER_SECRET=
VCC_RUNNER_IMAGE=vcc-runner:phase1
VCC_WORKER_MAX_CONCURRENCY=4
VCC_ALLOW_PUBLIC_CUSTOM_CODE=false

# Dedicated Linux-host packaging; absolute shared path MUST be identical in worker and host.
VCC_IPC_PARENT_DIR=/var/lib/vcc/ipc
VCC_ACCEPTANCE_HOST_DIR=/var/lib/vcc/acceptance
VCC_ISOLATION_ACCEPTANCE_FILE=/etc/vcc/acceptance/accepted.json
# Compose packaging can explicitly override VCC_FRONTEND_PORT=8080.
# /opt/vcc/gvisor is a fixed read-only host/runtime mount, not an image download.
# The checked-in Compose file defaults CORS to http://localhost:8080; this template's
# development VCC_CORS_ORIGINS must be changed for a packaged origin or future HTTPS.
