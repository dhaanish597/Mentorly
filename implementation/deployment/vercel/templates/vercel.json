{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/app/**/*.json,backend/app/**/*.sql,config/branding.json,config/local-development.json,config/supabase-prod-ca-2021.crt,exec_worker/vercel_sandbox/*.sql,exec_worker/vercel_sandbox/native/*,exec_worker/vercel_sandbox/accepted-runtime.json,frontend-index.html}",
      "excludeFiles": "{public/**,**/tests/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/ops/maintenance",
      "schedule": "0 2 * * *"
    }
  ]
}
